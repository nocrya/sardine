SARDINE_ENV=development
SARDINE_HTTP_ADDR=:8080

# PostgreSQL
SARDINE_DB_DSN=postgres://postgres:postgres@localhost:5432/sardine?sslmode=disable
SARDINE_DB_MAX_OPEN_CONNS=10
SARDINE_DB_MAX_IDLE_CONNS=5
SARDINE_DB_CONN_MAX_LIFETIME=30m

# CORS
SARDINE_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Auth
SARDINE_AUTH_JWT_SECRET=dev-secret-change-me
SARDINE_AUTH_ACCESS_TOKEN_TTL=24h
SARDINE_AUTH_BCRYPT_COST=12
SARDINE_AUTH_BOOTSTRAP_AUTO_MIGRATE=true
